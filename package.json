{
  "name": "klotho",
  "version": "0.0.1",
  "private": true,
  "packageManager": "npm@10.2.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev --filter=!@klotho/mobile",
    "mobile": "turbo build --filter=@klotho/shared --filter=@klotho/i18n --output-logs=errors-only && npm run start -w @klotho/mobile",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose -f apps/api/docker-compose.yml up -d",
    "db:down": "docker compose -f apps/api/docker-compose.yml down",
    "mobile:dev": "turbo build --filter=@klotho/shared --filter=@klotho/i18n --output-logs=errors-only && npm run start:dev-client -w @klotho/mobile"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "turbo": "^2.11.5",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
