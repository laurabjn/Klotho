generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  wardrobeItems       WardrobeItem[]
  styleProfile        StyleProfile?
}

/// Only the SHA-256 of the token is stored. Tokens rotated from the same login share a familyId.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

/// Single-use, short-lived. Only the SHA-256 of the token is stored.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum WardrobeCategory {
  TOP
  BOTTOM
  DRESS
  LAYER
  SHOES
  BAG
  ACCESSORY
  JEWELRY
  UNDERWEAR
}

enum WardrobeStatus {
  AVAILABLE
  WASHING
  LENT
  ARCHIVED
  SOLD
  DONATED
}

/// Colours, styles, seasons and pattern are keys of the shared taxonomy (packages/shared).
model WardrobeItem {
  id              String           @id @default(cuid())
  userId          String
  name            String?
  category        WardrobeCategory
  subcategory     String?
  primaryColor    String
  secondaryColors String[]
  pattern         String?
  material        String?
  styles          String[]
  seasons         String[]
  minTemperature  Int?
  maxTemperature  Int?
  warmthLevel     Int?
  formalityLevel  Int?
  brand           String?
  size            String?
  status          WardrobeStatus   @default(AVAILABLE)
  wearCount       Int              @default(0)
  lastWornAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos WardrobeItemPhoto[]

  @@index([userId, category, status])
  @@index([userId, createdAt])
  @@index([userId, lastWornAt])
}

/// Only the storage key is kept; the app receives short-lived signed URLs.
model WardrobeItemPhoto {
  id         String   @id @default(cuid())
  itemId     String
  storageKey String   @unique
  width      Int
  height     Int
  position   Int      @default(0)
  isMain     Boolean  @default(false)
  createdAt  DateTime @default(now())

  item WardrobeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, position])
}

/// One per user, created by the onboarding (or its "skip"). Keys come from packages/shared.
model StyleProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  preferredStyles     String[]
  preferredColors     String[]
  avoidedColors       String[]
  facePreferredColors String[]
  colorSeason         String?
  preferredMetals     String[]
  acceptsHeels        Boolean?
  preferredBottoms    String[]
  preferredFormality  Int?
  minLength           String?
  avoidsDeepNeckline  Boolean?
  onboardedAt         DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
