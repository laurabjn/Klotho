generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  bio          String?
  /// Storage key of the profile photo (an upload of the user, never a piece's photo).
  avatarKey    String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens        RefreshToken[]
  passwordResetTokens  PasswordResetToken[]
  emailChangeToken     EmailChangeToken?
  wardrobeItems        WardrobeItem[]
  styleProfile         StyleProfile?
  weatherSettings      WeatherSettings?
  outfits              Outfit[]
  outfitFeedbacks      OutfitFeedback[]
  outfitWears          OutfitWear[]
  outfitPlans          OutfitPlan[]
  dayNotes             DayNote[]
  notifications        Notification[]
  notificationSettings NotificationSettings?
  notificationMarkers  NotificationMarker[]
  aiUsages             AiUsage[]
  entitlement          Entitlement?
  creditGrants         CreditGrant[]
  usageEvents          UsageEvent[]
}

/// Only the SHA-256 of the token is stored. Tokens rotated from the same login share a familyId.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

/// Single-use, short-lived. Only the SHA-256 of the token is stored.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Pending e-mail change: one per user (a new request replaces it), single-use,
/// short-lived. Only the SHA-256 of the token is stored.
model EmailChangeToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  newEmail  String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum WardrobeCategory {
  TOP
  BOTTOM
  DRESS
  LAYER
  SHOES
  BAG
  ACCESSORY
  JEWELRY
  UNDERWEAR
}

enum WardrobeStatus {
  AVAILABLE
  WASHING
  LENT
  ARCHIVED
  SOLD
  DONATED
}

/// Colours, styles, seasons and pattern are keys of the shared taxonomy (packages/shared).
model WardrobeItem {
  id              String           @id @default(cuid())
  userId          String
  name            String?
  category        WardrobeCategory
  subcategory     String?
  primaryColor    String
  secondaryColors String[]
  pattern         String?
  material        String?
  styles          String[]
  seasons         String[]
  minTemperature  Int?
  maxTemperature  Int?
  warmthLevel     Int?
  formalityLevel  Int?
  brand           String?
  size            String?
  status          WardrobeStatus   @default(AVAILABLE)
  wearCount       Int              @default(0)
  lastWornAt      DateTime?
  isFavorite      Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos      WardrobeItemPhoto[]
  outfitItems OutfitItem[]

  @@index([userId, category, status])
  @@index([userId, createdAt])
  @@index([userId, lastWornAt])
  /// "Most / least worn" sorts of the wardrobe list.
  @@index([userId, wearCount])
}

/// Only the storage key is kept; the app receives short-lived signed URLs.
model WardrobeItemPhoto {
  id         String   @id @default(cuid())
  itemId     String
  storageKey String   @unique
  width      Int
  height     Int
  position   Int      @default(0)
  isMain     Boolean  @default(false)
  createdAt  DateTime @default(now())

  item WardrobeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, position])
}

/// One per user, created by the onboarding (or its "skip"). Keys come from packages/shared.
model StyleProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  preferredStyles     String[]
  preferredColors     String[]
  avoidedColors       String[]
  facePreferredColors String[]
  colorSeason         String?
  preferredMetals     String[]
  acceptsHeels        Boolean?
  preferredBottoms    String[]
  preferredFormality  Int?
  minLength           String?
  avoidsDeepNeckline  Boolean?
  onboardedAt         DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Location mode, saved city (its own coordinates) and unit. The device position is never stored.
model WeatherSettings {
  id              String   @id @default(cuid())
  userId          String   @unique
  locationMode    String?
  cityName        String?
  cityCountry     String?
  cityRegion      String?
  cityLatitude    Float?
  cityLongitude   Float?
  temperatureUnit String   @default("celsius")
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A look proposed by the outfit engine. Its score stays on the server.
model Outfit {
  id               String    @id @default(cuid())
  userId           String
  style            String?
  occasion         String?
  temperature      Int?
  weatherCondition String?
  score            Float
  /// Sub-scores (0 to 1) behind "Pourquoi cette tenue ?".
  breakdown        Json
  isFavorite       Boolean   @default(false)
  /// When it became a favourite ("Favoris" lists the latest first).
  favoritedAt      DateTime?
  /// The look this one is a variant of.
  variantOfId      String?
  createdAt        DateTime  @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     OutfitItem[]
  feedbacks OutfitFeedback[]
  wears     OutfitWear[]
  plans     OutfitPlan[]

  @@index([userId, createdAt])
  @@index([userId, isFavorite, favoritedAt])
}

model OutfitItem {
  id             String @id @default(cuid())
  outfitId       String
  wardrobeItemId String
  role           String

  outfit       Outfit       @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  wardrobeItem WardrobeItem @relation(fields: [wardrobeItemId], references: [id], onDelete: Cascade)

  @@unique([outfitId, role])
  @@index([wardrobeItemId])
}

/// The user's opinion of a look: one per look, the last one wins. Reasons are keys of packages/shared.
model OutfitFeedback {
  id        String   @id @default(cuid())
  outfitId  String
  userId    String
  rating    String
  reasons   String[]
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outfit Outfit @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([outfitId, userId])
  @@index([userId])
}

/// A day a look was worn, in the user's own calendar (no time, no time zone).
model OutfitWear {
  id        String   @id @default(cuid())
  userId    String
  outfitId  String
  wornOn    DateTime @db.Date
  createdAt DateTime @default(now())

  outfit Outfit @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([outfitId, wornOn])
  @@index([userId, wornOn])
}

/// A look planned for a day of the user's calendar: one per day. The forecast
/// it was planned with is kept when it was known.
model OutfitPlan {
  id                  String   @id @default(cuid())
  userId              String
  outfitId            String
  day                 DateTime @db.Date
  forecastTemperature Int?
  forecastCondition   String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  outfit Outfit @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([outfitId])
}

/// "Notes" of a day of the calendar: one per day.
model DayNote {
  id        String   @id @default(cuid())
  userId    String
  day       DateTime @db.Date
  text      String
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

/// A notification of the in-app centre. Only its kind and data are stored:
/// the app writes the text in its language, and photo URLs are signed when read.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  /// A NOTIFICATION_KINDS key of packages/shared.
  kind      String
  /// NotificationData without imageUrl.
  data      Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// The switches of "Notifications" in Paramètres; none stored means the defaults.
model NotificationSettings {
  userId       String   @id
  tips         Boolean  @default(true)
  reminders    Boolean  @default(true)
  news         Boolean  @default(false)
  /// HH:MM, on the phone's own clock.
  reminderTime String   @default("08:00")
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// When a time-based notification kind was last created for a user (and
/// about what), so that it is not created again too soon, even once deleted.
model NotificationMarker {
  userId    String
  kind      String
  createdAt DateTime
  /// The piece of the last forgottenPiece, never notified twice in a row.
  ref       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, kind])
}

/// One call to a paid AI service: cost follow-up per user and feature, and quotas.
model AiUsage {
  id           String   @id @default(cuid())
  userId       String
  /// photoAnalysis
  feature      String
  model        String
  inputTokens  Int
  outputTokens Int
  /// Quota it was taken from: monthly (Premium) or balance; null when not
  /// counted (no piece found).
  pool         String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, feature])
}

/// The paid plan of a user, as last confirmed by the store (RevenueCat).
model Entitlement {
  userId    String    @id
  /// premium or founders
  plan      String
  productId String
  /// Null for the lifetime founders offer.
  expiresAt DateTime?
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// AI credits bought (packs) or included (founders), once per store transaction.
model CreditGrant {
  id            String   @id @default(cuid())
  userId        String
  amount        Int
  productId     String
  transactionId String   @unique
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Metered features of the free plan (outfit generations).
model UsageEvent {
  id        String   @id @default(cuid())
  userId    String
  feature   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, feature, createdAt])
}
