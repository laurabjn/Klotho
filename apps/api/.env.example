# Copy to .env and adjust. Never commit .env files.
NODE_ENV=development
PORT=3100

# Matches docker-compose.yml defaults (local only)
DATABASE_URL=postgresql://klotho:klotho@localhost:5433/klotho

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# Optional (defaults shown)
# JWT_ACCESS_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# PASSWORD_RESET_TTL_MINUTES=60
# RESET_PASSWORD_URL=klotho://reset-password
# E-mail change: confirmation link sent to the new address.
# EMAIL_CHANGE_TTL_MINUTES=60
# CONFIRM_EMAIL_URL=klotho://confirm-email
# BCRYPT_COST=12
# MAIL_DRIVER=console
# Production e-mails (password reset, e-mail change) with Brevo (https://www.brevo.com,
# free up to 300 e-mails a day): MAIL_DRIVER=brevo, the API key, and a
# sender address verified in Brevo.
# BREVO_API_KEY=
# MAIL_FROM=contact@example.com
# MAIL_FROM_NAME=Klotho

# Photo storage (S3 API). Local: the RustFS container of docker-compose.yml.
# Production: Cloudflare R2 (endpoint https://<account>.r2.cloudflarestorage.com, region auto).
STORAGE_ENDPOINT=http://localhost:9010
# Address used in the photo links sent to the app. On a phone, use your PC IP.
STORAGE_PUBLIC_ENDPOINT=http://localhost:9010
STORAGE_REGION=us-east-1
STORAGE_BUCKET=klotho-photos
STORAGE_ACCESS_KEY_ID=klotho
STORAGE_SECRET_ACCESS_KEY=klotho-dev-secret
# Creates the bucket at start-up if missing (development only).
STORAGE_CREATE_BUCKET=true
# PHOTOS_MAX_PER_ITEM=5

# Weather: OpenWeatherMap (free account, https://home.openweathermap.org/api_keys).
# Without a key, the app only offers a manually entered temperature. Required in production.
OPENWEATHER_API_KEY=
# WEATHER_TIMEOUT_MS=5000
# WEATHER_CACHE_TTL_SECONDS=600

# Logs: json (default in production) or pretty (default elsewhere).
# LOG_FORMAT=pretty
# LOG_HTTP_REQUESTS=true
# Number of reverse proxies in front of the API (client IP for rate limits).
# TRUST_PROXY=0

# Rate limits, per client IP: <requests>/<seconds> (defaults shown).
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_LOGIN=10/60
# RATE_LIMIT_REGISTER=5/60
# RATE_LIMIT_FORGOT_PASSWORD=5/900
# RATE_LIMIT_RESET_PASSWORD=10/900
# RATE_LIMIT_REFRESH=30/60
# Uploads: per IP and per account.
# RATE_LIMIT_UPLOADS=30/60
