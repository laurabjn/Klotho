# Optional: API used by the app. By default, the machine running the Expo
# dev server on port 3100 (works from a phone on the same Wi-Fi).
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3100

# Optional: crash reporting (Sentry project's DSN). Without it, nothing is sent.
# EXPO_PUBLIC_SENTRY_DSN=https://xxxx@o0.ingest.de.sentry.io/0

# Optional: purchases (RevenueCat public SDK keys, Project settings > API keys).
# Purchases only work in the installed app (beta build), never in Expo Go.
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_...
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_...
